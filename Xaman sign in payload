import requests

# Xaman API endpoint to create a sign-in payload
url = "https://xumm.app/api/v1/platform/payload"
headers = {
    "X-API-Key": "YOUR_XAMAN_API_KEY",
    "X-API-Secret": "YOUR_XAMAN_API_SECRET",
    "Content-Type": "application/json"
}
payload = {
    "txjson": {
        "TransactionType": "SignIn"
    }
}

response = requests.post(url, json=payload, headers=headers)
data = response.json()

# This URL must be shown to the user (or converted to a QR code)
signin_url = data['next']['always']
