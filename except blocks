from solana.rpc.api import Client
from solana.publickey import PublicKey

# Initialize client (ensure this matches your network)
client = Client("https://api.devnet.solana.com")

def get_account_info(pubkey_str):
    try:
        pubkey = PublicKey(pubkey_str)
        response = client.get_account_info(pubkey)
        if response['result']['value'] is None:
            return "Account not found. Please ensure it is initialized."
        return response
    except ValueError:
        return "Invalid wallet address format."
    except Exception as e:
        return f"Error: {str(e)}"
