import re

# Digital root function
def digital_root(n):
    if n == 0:
        return 0
    return 1 + (n - 1) % 9

# Word value calculator
def word_value(word, mapping):
    word = re.sub(r'[^a-zA-Z]', '', word).lower()
    total = sum(mapping.get(char, 0) for char in word)
    return digital_root(total)

# Harmonic classification
def classify_word(val):
    if val in [3, 6, 9]:
        return 'A'  # Spiritual / Creative
    elif val in [1, 4, 7]:
        return 'B'  # Mental / Analytical
    elif val in [2, 5, 8]:
        return 'C'  # Emotional / Social
    return 'Unknown'

