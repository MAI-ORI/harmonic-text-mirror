import streamlit as st
import requests
import time

XAMAN_API_KEY = "your_api_key_here"
XAMAN_API_SECRET = "your_api_secret_here"

def create_xaman_payload():
    url = "https://xumm.app/api/v1/platform/payload"
    headers = {
        "X-API-Key": XAMAN_API_KEY,
        "X-API-Secret": XAMAN_API_SECRET,
        "Content-Type": "application/json"
    }
    data = {
        "txjson": {
            "TransactionType": "SignIn"
        }
    }
    response = requests.post(url, json=data, headers=headers)
    return response.json()

def check_payload_status(uuid):
    url = f"https://xumm.app/api/v1/platform/payload/{uuid}"
    headers = {
        "X-API-Key": XAMAN_API_KEY,
        "X-API-Secret": XAMAN_API_SECRET
    }
    response = requests.get(url, headers=headers)
    return response.json()

st.title("Harmonic Text Mirror - Wallet Connect")

if st.button("Connect Xaman Wallet"):
    payload = create_xaman_payload()
    uuid = payload['uuid']
    qr_url = payload['refs']['qr_png']
    
    st.image(qr_url, caption="Scan this QR code with your Xaman app")
    
    # Poll for signature
    with st.spinner("Waiting for signature..."):
        for _ in range(30):  # Poll for up to 30 seconds
            time.sleep(1)
            status = check_payload_status(uuid)
            if status['meta']['signed']:
                user_address = status['response']['account']
                st.success(f"Connected! Wallet Address: {user_address}")
                st.session_state['wallet_address'] = user_address
                break
        else:
            st.error("Connection timed out.")
